# Demo cell — demo.getstride.co.ke (multi-vertical industry tour, isolated Neon)
# Apply: node scripts/setup-demo-getstride-vercel.mjs
# Seed DB: npm run demo:cell:provision  (all-verticals + enrichment + fleet)

SITE_MODE="app"
NEXT_PUBLIC_SITE_URL="https://demo.getstride.co.ke"
NEXT_PUBLIC_APP_ORIGIN="https://demo.getstride.co.ke"
NEXTAUTH_URL="https://demo.getstride.co.ke"

NEXT_PUBLIC_APP_NAME="Stride"
NEXT_PUBLIC_BRAND_WORDMARK="Stride"
NEXT_PUBLIC_BRAND_LOGO="/brand/stride-mark.svg"
NEXT_PUBLIC_BRAND_LOGO_PNG="/brand/stride-mark.svg"
NEXT_PUBLIC_APP_TAGLINE="The Vertical BMS — explore payroll and people ops across industries."

# Multi-company sales sandbox — switch industry via top-bar (no single DEMO_PACK identity)
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"
DEMO_MULTI_CONTEXT="true"
MULTI_ENTITY_ENABLED="true"
NEXT_PUBLIC_SHOW_DEMO_LOGIN_HINT="true"
NEXT_PUBLIC_TENANT_LOGIN_BRANDING="true"
NEXT_PUBLIC_DEMO_ACCESS_PAGE="false"

# One login for every company in the switcher (sales collateral unchanged)
DEMO_UNIFIED_ADMIN_EMAIL="admin@imara.co.ke"
NEXT_PUBLIC_DEMO_ADMIN_EMAIL="admin@imara.co.ke"
NEXT_PUBLIC_DEMO_PASSWORD="Demo@2026!"
STAFF_PASSWORD="Demo@2026!"

# Pack email domains + shared admin domain (login + ESS)
STAFF_ALLOWED_DOMAIN="imara.co.ke,savannahfreight.co.ke,heritage.demo.getstride.co.ke,northline.imara.co.ke,amani.imara.co.ke,horizon.imara.co.ke,kilimani.imara.co.ke,example.com,nyati.imara.co.ke,eaglehr.co.ke"

# Hint emails shown on demo login (Savannah logistics ESS / HR remain useful defaults)
NEXT_PUBLIC_DEMO_HR_EMAIL="hr@savannahfreight.co.ke"
NEXT_PUBLIC_DEMO_APPROVER_EMAIL="hr@savannahfreight.co.ke"
NEXT_PUBLIC_DEMO_FINANCE_EMAIL="finance@savannahfreight.co.ke"
NEXT_PUBLIC_DEMO_ESS_EMAIL="moses.okello@savannahfreight.co.ke"

RUN_MIGRATIONS_ON_BUILD="false"

# Required for control-plane Users tab + org lookup (same value as control-plane):
# STRIDE_CELL_PROVISION_KEY=

# Set on Vercel from .env.demo-cell.local (isolated Neon — not app.getstride.co.ke):
# DATABASE_URL=
# DIRECT_DATABASE_URL=
