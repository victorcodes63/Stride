# Savannah Freight & Logistics — cargo & logistics flagship demo
# Apply: npm run demo:reseed:cargo-logistics

DEMO_PACK=cargo-logistics
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

NEXT_PUBLIC_APP_NAME="Stride"
NEXT_PUBLIC_ORG_NAME="Savannah Freight & Logistics Ltd"
NEXT_PUBLIC_APP_TAGLINE="Fleet, warehouse, and dispatch operations — payroll and compliance for logistics teams."
NEXT_PUBLIC_BRAND_LOGO="/brand/stride-mark.png"
NEXT_PUBLIC_BRAND_LOGO_PNG="/brand/stride-mark.png"
NEXT_PUBLIC_BRAND_WORDMARK="Stride"
NEXT_PUBLIC_RECRUITMENT_EMPLOYER_NAME="Savannah Freight & Logistics Ltd"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

STAFF_ALLOWED_DOMAIN="savannahfreight.co.ke,imara.co.ke,raventechgroup.com,example.com"
NEXT_PUBLIC_DEMO_ADMIN_EMAIL="admin@imara.co.ke"
NEXT_PUBLIC_DEMO_HR_EMAIL="hr@savannahfreight.co.ke"
NEXT_PUBLIC_DEMO_APPROVER_EMAIL="hr@savannahfreight.co.ke"
NEXT_PUBLIC_DEMO_FINANCE_EMAIL="finance@savannahfreight.co.ke"
NEXT_PUBLIC_DEMO_ESS_EMAIL="moses.okello@savannahfreight.co.ke"
NEXT_PUBLIC_DEMO_PASSWORD="Demo@2026!"
STAFF_PASSWORD="Demo@2026!"

# Single-company flagship: do NOT enable multi-context (that seeds every vertical at once)
DEMO_MULTI_CONTEXT=false
